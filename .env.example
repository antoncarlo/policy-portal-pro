# ---------------------------------------------------------------------------
# Browser (variabili VITE_*: finiscono nel codice pubblico, mai segreti)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"

# ---------------------------------------------------------------------------
# Server (funzioni /api su Vercel)
# ---------------------------------------------------------------------------
SUPABASE_URL="https://your-project-id.supabase.co"        # se manca si usa VITE_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
PORTAL_URL="https://portale.tecnomga.com"                  # indirizzo dei link nelle email e degli indirizzi dei connettori

# Cron: Vercel invia "Authorization: Bearer <CRON_SECRET>"; senza il segreto i cron restano chiusi
CRON_SECRET="a-long-random-secret"

# Email: Gmail/Google Workspace (password per le app) oppure Resend; se ci sono entrambi vince Gmail
GMAIL_USER="portale@tecnomga.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
GMAIL_FROM=""                                              # opzionale: indirizzo mittente se diverso da GMAIL_USER
RESEND_API_KEY="your-resend-key"
EMAIL_FROM="notifiche@tecnomga.com"                        # mittente per Resend (dominio verificato)
EMAIL_FROM_NAME="Tecno Advance MGA"
# Caselle fisse che ricevono le NUOVE PRATICHE (oltre agli amministratori). "none" le disattiva
ADMIN_NOTIFICATION_EMAILS="info@tecnomga.com,antoncarlo@tecnomga.com"

# API partner (webhook polizze, note, stato, VIES)
WEBHOOK_SECRET="your-hmac-secret"                          # firma HMAC-SHA256 del corpo di /api/webhook-receive-policy
# Transition: also accept a signature computed on the re-serialised body. Set to "off" once every integrator signs the exact bytes it sends.
# WEBHOOK_REENCODED_SIGNATURE=off
WEBHOOK_DEFAULT_USER_ID="uuid-of-admin-user"               # titolare delle pratiche create dall'API senza utente mappato
ALLOWED_IPS=""                                             # elenco separato da virgole; vuoto = nessun filtro IP
PORTAL_API_KEY=""                                          # chiave legacy (solo se serve ancora): preferire le chiavi in Impostazioni → API
API_CORS_ORIGINS=""                                        # origini browser ammesse alle API partner (vuoto = nessuna)

# Connettore VIES / portale della compagnia (vedi docs/vies-connector.md)
VIES_WORKER_SECRET="a-long-random-secret"
VIES_PORTALS=""                                            # JSON con i portali collegati
VIES_PORTAL_CALLBACK_SECRET=""
