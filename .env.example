VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Resend email
VITE_RESEND_API_KEY="your-resend-api-key"
VITE_EMAIL_FROM="notifiche@tecnomga.com"
VITE_EMAIL_FROM_NAME="Tecno Advance MGA"

# Webhook API security
PORTAL_API_KEY="your-secure-api-key-here"
WEBHOOK_SECRET="your-hmac-secret-here"
ALLOWED_IPS=""                        # comma-separated list; leave empty to allow all IPs
WEBHOOK_DEFAULT_USER_ID="uuid-of-admin-user-here"

# Supabase server-side (Vercel functions)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Admin notification recipients (comma-separated)
ADMIN_NOTIFICATION_EMAILS="info@tecnomga.com,antoncarlo@tecnomga.com"

# Resend (server-side, Vercel functions)
RESEND_API_KEY="your-resend-key"
